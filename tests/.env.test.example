# 测试环境变量配置示例
# 复制此文件为 .env.test 并填入实际值

# 测试服务器配置
TEST_MAIN_SERVER=http://localhost:8050
TEST_ADMIN_SERVER=http://localhost:8060

# 测试用户配置
TEST_USER_ID=user_alice
TEST_MODEL=gemini-2.0-flash-exp

# 内存Token（简单格式）
TEST_MEMORY_TOKEN=user_alice

# 管理员Token
TEST_ADMIN_TOKEN=super-secret-admin-key

# 注意：LLM_API_KEY 和 LLM_BASE_URL 等其他配置
# 应该从主 .env 文件中读取，这里不重复定义
