# 应用配置
APP_NAME=Mem0 Chat API
HOST=0.0.0.0
PORT=8050
DEBUG=false

# 认证配置
ADMIN_SECRET_KEY=your-secret-admin-key-here

# 数据库配置
DB_TYPE=sqlite
DB_URL=sqlite:///./memories.db

# LLM 服务提供商配置
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash-exp
LLM_API_KEY=your_google_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004

# Mem0 配置
MEM0_CONFIG_TYPE=chroma

# Chroma 配置
CHROMA_PATH=./chroma_db

# 日志配置
LOG_LEVEL=INFO

# 其他配置
TIMEOUT=30
MAX_RETRIES=3

# 禁用 PostHog 遥测
POSTHOG_DISABLED=true

# ==============================================
# 其他LLM提供商配置示例（可选）
# ==============================================

# OpenAI 配置示例：
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-openai-api-key-here
# EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter 配置示例：
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3-sonnet
# LLM_API_KEY=sk-your-openrouter-api-key-here
# EMBEDDING_MODEL=text-embedding-3-small

# Ollama 配置示例：
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b-instruct-8k
# LLM_API_KEY=
# EMBEDDING_MODEL=nomic-embed-text

# PostgreSQL 数据库配置示例（可选，替代SQLite）：
# DB_TYPE=postgresql
# DB_URL=postgresql://user:password@localhost:5432/mem0_db