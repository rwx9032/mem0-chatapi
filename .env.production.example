# 生产环境配置示例
# 复制此文件为 .env.production 并填入生产环境的实际值

# 应用配置
APP_NAME=Mem0 Chat API
HOST=0.0.0.0
PORT=8050
DEBUG=false

# 认证配置 - 生产环境请使用强密码
ADMIN_SECRET_KEY=your-strong-production-admin-key-here

# 数据库配置 - 生产环境推荐使用PostgreSQL
DB_TYPE=postgresql
DB_URL=postgresql://username:password@localhost:5432/mem0_production

# LLM 服务提供商配置
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash-exp
LLM_API_KEY=your_production_google_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004

# Mem0 配置
MEM0_CONFIG_TYPE=chroma

# Chroma 配置 - 生产环境推荐使用绝对路径
CHROMA_PATH=/var/lib/mem0/chroma_db

# 日志配置 - 生产环境推荐ERROR级别
LOG_LEVEL=ERROR

# 性能配置
TIMEOUT=60
MAX_RETRIES=3

# 禁用遥测
POSTHOG_DISABLED=true

# 生产环境安全配置
# 建议启用HTTPS、设置防火墙规则、限制访问IP等
